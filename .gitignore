# ----------------------------------------------------------------------------
# Ignore Pattern Examples (reference templates)
# ----------------------------------------------------------------------------
# Keep these commented unless you want to activate them.
# Rules are evaluated top-to-bottom; last matching rule wins.
#
# 1) Root-only file type rules
# Ignore only root-level .log files:
# /*.log
#
# Include only root-level .json after broad ignore:
# *.json
# !/*.json
#
# 2) Specific file depth rules
# Include level-1 files under reports/:
# !/reports/*.json
#
# Include level-2 files under reports/:
# !/reports/*/*.json
#
# Include level-3 files under reports/:
# !/reports/*/*/*.json
#
# 3) Directory-level allowlist (ignore everything else in that directory tree)
# Ignore everything in exports/:
# /exports/**
#
# Re-include the directory itself so child patterns can apply:
# !/exports/
#
# Re-include only selected file types (all others remain ignored):
# !/exports/**/*.csv
# !/exports/**/*.md
#
# 4) Directory-level blocklist by file type
# Ignore all .tmp files only inside cache/ at any depth:
# /cache/**/*.tmp
#
# 5) Validate pattern behavior
# git check-ignore -v path/to/file

# 6) Root-only directory rules
# Ignore only root-level directories:
# /build/
# /cache/
#
# 7) Directory-name rules at any depth
# Ignore any directory named cache anywhere in the repository:
# cache/
#
# 8) Specific directory depth rules
# Ignore only level-1 directories under snapshots/:
# /snapshots/*/
#
# Ignore only level-2 directories under snapshots/:
# /snapshots/*/*/
#
# 9) Directory allowlist at a specific level
# Ignore all first-level directories under assets/:
# /assets/*/
#
# Re-include only selected directories:
# !/assets/images/
# !/assets/icons/
#
# 10) Keep directory structure only (ignore all files)
# Ignore everything under skeleton/:
# /skeleton/**
#
# Re-include only directories (no files):
# !/skeleton/
# !/skeleton/**/
#
# 11) Nested .gitignore pattern (root controls what is re-included)
# Ignore contents of .ace/, but keep its local .gitignore trackable:
# /.ace/*
# !/.ace/.gitignore
#
# Optional explicit re-include(s) managed only from root .gitignore:
# !/.ace/keep-me.txt
#
# 12) Nested .gitignore pattern (allow local .gitignore to manage that directory)
# Root .gitignore must unignore the parent directory first:
# /.ace/*
# !/.ace/
# !/.ace/.gitignore
#
# Then in .ace/.gitignore you can define local rules, for example:
# *
# !.gitignore
# !keep/**
#
# Validate directory pattern behavior:
# git check-ignore -v path/to/dir/


