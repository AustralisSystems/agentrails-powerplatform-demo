!/.ace/.gitignore
!/.ace/artifacts/
!/.ace/artifacts/.gitignore
!/.ace/data/
!/.ace/data/.gitignore
!/.ace/logs/
!/.ace/logs/.gitignore

!.ace-data/             # Keep the .ace-data directory itself, but ignore its contents (managed by .ace-data/.gitignore)
.agent_workspace/
!.agents/               # Keep the .agents directory itself, but ignore its contents (managed by .agents/.gitignore)
!.agents-backups/       # Keep the .agents-backups directory itself, but ignore its contents (managed by .agents-backups/.gitignore)
.artifacts/
.checkpoints/
.codeql_db/
!.config/               # Keep the .config directory itself, but ignore its contents (managed by .config/.gitignore)
