# ----------------------------------------------------------------------------
# Reference Lib for cloning and reaping and reference content, repos and code not intended for long-term storage
# ----------------------------------------------------------------------------
!/_reference_lib/                 # Keep the _reference_lib directory itself, but ignore its contents (managed by _reference_lib/.gitignore)
!**/_reference_lib/               # Keep any _reference_lib directory at any depth, but ignore its contents (managed by that directory's own .gitignore)
!/.reference_lib/                 # Keep the .reference_lib directory itself, but ignore its contents (managed by .reference_lib/.gitignore)
!**/.reference_lib/               # Keep any .reference_lib directory at any depth, but ignore its contents (managed by that directory's own .gitignore)
!/docs/_reference_lib_docs/       # Keep the docs/_reference_lib_docs directory itself, but ignore its contents (managed by docs/_reference_lib_docs/.gitignore)
!**/docs/_reference_lib_docs/     # Keep any docs/_reference_lib_docs directory at any depth, but ignore its contents (managed by that directory's own .gitignore)


